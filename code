def twoPluses(grid):
    n = len(grid)
    m = len(grid[0])

    pluses = []

    for r in range(n):
        for c in range(m):
            if grid[r][c] != 'G':
                continue

            length = 0

            while True:
                cells = {(r, c)}

                valid = True
                for k in range(1, length + 1):
                    positions = [
                        (r - k, c),
                        (r + k, c),
                        (r, c - k),
                        (r, c + k)
                    ]

                    for x, y in positions:
                        if (x < 0 or x >= n or
                            y < 0 or y >= m or
                            grid[x][y] != 'G'):
                            valid = False
                            break

                    if not valid:
                        break

                    cells.update(positions)

                if not valid:
                    break

                area = 1 + 4 * length
                pluses.append((area, cells))
                length += 1

    max_product = 0

    for i in range(len(pluses)):
        area1, cells1 = pluses[i]

        for j in range(i + 1, len(pluses)):
            area2, cells2 = pluses[j]

            if cells1.isdisjoint(cells2):
                max_product = max(max_product, area1 * area2)

    return max_product


n, m = map(int, input().split())
grid = [input().strip() for _ in range(n)]

print(twoPluses(grid))


